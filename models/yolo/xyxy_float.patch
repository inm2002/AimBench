+                owner->insert(owner->end(), {b.left, b.top, b.right, b.bottom});
+            }
+            return py::array(
+                py::buffer_info(
+                    owner->data(),
+                    sizeof(float),
+                    py::format_descriptor<float>::format(),
+                    2,
+                    std::vector<size_t>{r.boxes.size(), 4},
+                    std::vector<size_t>{sizeof(float) * 4, sizeof(float)}),
+                py::cast(owner)); },
